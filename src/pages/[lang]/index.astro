                                        {"★★★★★"}
                                    </div>
                                    <p class="text-muted-foreground text-sm leading-relaxed flex-1">
                                        "{item.text}"
                                    </p>
                                    <div class="flex items-center gap-3 pt-3 border-t border-border">
                                        <div class="w-9 h-9 rounded-full bg-k-green/10 text-k-green dark:text-k-green-light flex items-center justify-center text-xs font-bold shrink-0">
                                            {initials}
                                        </div>
                                        <div>
                                            <p class="text-sm font-semibold text-foreground">
                                                {item.name}
                                            </p>
                                            <p class="text-xs text-muted-foreground">
                                                {item.role} · {item.company}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </section>
        */}
    </main>
</MainLayout>
