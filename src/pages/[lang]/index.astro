---
import MainLayout from "../../layouts/main-layout.astro";
import Hero from "../../components/hero.astro";
import TechBelt from "../../components/tech-belt.astro";
import {
    CodeXml,
    GitMerge,
    Wrench,
    Lightbulb,
    Zap,
    Headset,
    Users,
} from "@lucide/astro";
import { getLangFromUrl, getTranslations } from "../../lib/i18n";

/**
 * Requerido en toda página dentro de [lang]/ con rutas dinámicas.
 * Astro la ejecuta automáticamente en build para saber qué versiones
 * de esta página generar, una por cada idioma soportado.
 * @returns Lista de parámetros de ruta estática
 */
export function getStaticPaths() {
    return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { url } = Astro;
const lang = getLangFromUrl(url);
const t = getTranslations(lang);
const seo = t.meta.pages.home;

const servicesSection = t.home_page.services_section;
const whyUs = t.home_page.why_us;
const testimonials = t.home_page.testimonials;
const clients = t.home_page.clients;
const services = t.services_page.items;

const serviceIcons: Record<string, any> = {
    development: CodeXml,
    integrations: GitMerge,
    maintenance: Wrench,
    consulting: Lightbulb,
};

// Iconos para "Por qué Kadabra": velocidad, integraciones, soporte, equipo
const whyUsIcons = [Zap, GitMerge, Headset, Users];
---

<!-- HOME PAGE -->
<MainLayout title={seo.title} description={seo.description}>
    <main class="bg-background">
        <Hero />
        <TechBelt t={t} />

        <!-- Servicios -->
        <section class="py-20 bg-background">
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-col items-center text-center gap-3 mb-14">
                    <span class="text-sm font-bold tracking-widest uppercase text-k-green dark:text-k-green-light">
                        {servicesSection.label}
                    </span>
                    <h2 class="text-3xl md:text-4xl font-bold text-foreground max-w-2xl">
                        {servicesSection.title}
                    </h2>
                    <p class="text-muted-foreground max-w-xl">
                        {servicesSection.subtitle}
                    </p>
                </div>
                <div class="grid sm:grid-cols-2 gap-6 mb-12">
                    {
                        services.map((svc: any) => {
                            const Icon = serviceIcons[svc.id];
                            return (
                                <a
                                    href={`/${lang}/servicios#${svc.id}`}
                                    class="group flex flex-col gap-4 p-6 rounded-2xl border border-border bg-card hover:border-k-green/50 transition-colors"
                                >
                                    <div class="flex items-center gap-3">
                                        <div class="p-2.5 rounded-xl bg-k-green/10 text-k-green dark:text-k-green-light group-hover:bg-k-green/20 transition-colors">
                                            <Icon class="h-5 w-5" />
                                        </div>
                                        <h3 class="font-bold text-foreground">
                                            {svc.title}
                                        </h3>
                                    </div>
                                    <p class="text-sm text-muted-foreground leading-relaxed flex-1">
                                        {svc.summary}
                                    </p>
                                    <span class="text-xs font-semibold text-k-green dark:text-k-green-light mt-auto">
                                        Ver más →
                                    </span>
                                </a>
                            );
                        })
                    }
                </div>
                <div class="flex justify-center">
                    <a
                        href={`/${lang}/servicios`}
                        class="bg-k-dark hover:bg-k-dark-dark text-primary-foreground px-8 py-3 rounded-2xl font-bold text-sm tracking-wide transition-all active:scale-[0.97] border-2 border-k-dark-light"
                    >
                        {servicesSection.cta} →
                    </a>
                </div>
            </div>
        </section>

        <!-- Por qué Kadabra -->
        <section class="py-20 bg-card">
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-col items-center text-center gap-3 mb-14">
                    <span class="text-sm font-bold tracking-widest uppercase text-k-green dark:text-k-green-light">
                        {whyUs.label}
                    </span>
                    <h2 class="text-3xl md:text-4xl font-bold text-foreground max-w-2xl">
                        {whyUs.title}
                    </h2>
                </div>
                <div class="grid sm:grid-cols-2 gap-6">
                    {
                        whyUs.items.map((item: any, i: number) => {
                            const Icon = whyUsIcons[i];
                            return (
                                <div class="flex gap-5 p-6 rounded-2xl border border-border bg-background">
                                    <div class="p-3 rounded-xl bg-k-green/10 text-k-green dark:text-k-green-light h-fit shrink-0">
                                        <Icon class="h-5 w-5" />
                                    </div>
                                    <div class="flex flex-col gap-2">
                                        <h3 class="font-bold text-foreground">
                                            {item.title}
                                        </h3>
                                        <p class="text-sm text-muted-foreground leading-relaxed">
                                            {item.description}
                                        </p>
                                    </div>
                                </div>
                            );
                        })
                    }
                </div>
            </div>
        </section>

        <!-- Clientes -->
        <section class="py-20 bg-card">
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-col items-center text-center gap-3 mb-14">
                    <span class="text-sm font-bold tracking-widest uppercase text-k-green dark:text-k-green-light">
                        {clients.label}
                    </span>
                    <h2 class="text-3xl md:text-4xl font-bold text-foreground max-w-2xl">
                        {clients.title}
                    </h2>
                </div>
                <div class="flex flex-wrap items-center justify-center gap-12">
                    {clients.items.map((client: any) => (
                        <a href={client.href} target="_blank" rel="noopener noreferrer"
                            class="group relative grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
                            <img src={client.logo} alt={client.name} class="h-10 w-auto object-contain mix-blend-multiply dark:mix-blend-screen dark:brightness-150" />
                            <span class="pointer-events-none absolute -top-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-foreground px-2.5 py-1 text-xs font-semibold text-background opacity-0 shadow-md transition-opacity duration-200 group-hover:opacity-100">
                                {client.name}
                            </span>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        {/* TODO: descomentar cuando haya reseñas reales
        <!-- Testimonios -->
        <section class="py-20 bg-background">
            <div class="max-w-7xl mx-auto px-6">
                <div class="flex flex-col items-center text-center gap-3 mb-14">
                    <span class="text-sm font-bold tracking-widest uppercase text-k-green dark:text-k-green-light">
                        {testimonials.label}
                    </span>
                    <h2 class="text-3xl md:text-4xl font-bold text-foreground max-w-2xl">
                        {testimonials.title}
                    </h2>
                </div>
                <div class="grid md:grid-cols-3 gap-6">
                    {
                        testimonials.items.map((item: any) => {
                            const initials: string = item.name
