---
import MainLayout from "../layouts/main-layout.astro";
import { getLangFromUrl, getTranslations } from "../lib/i18n";

const { url } = Astro;
const lang = getLangFromUrl(url);
const t = getTranslations(lang);
const is404 = {
    es: {
        title: "Página no encontrada",
        subtitle: "La página que buscas no existe o fue movida.",
        cta: "Volver al inicio",
    },
    en: {
        title: "Page not found",
        subtitle: "The page you're looking for doesn't exist or was moved.",
        cta: "Back to home",
    },
};
const c = is404[lang as "es" | "en"] ?? is404.es;
---

<MainLayout>
    <main class="bg-background min-h-[70vh] flex items-center justify-center">
        <div
            class="max-w-xl mx-auto px-6 py-32 flex flex-col items-center text-center gap-6"
        >
            <span
                class="font-mono text-8xl font-black text-k-green dark:text-k-green-light opacity-20 select-none leading-none"
            >
                404
            </span>
            <h1 class="text-3xl md:text-4xl font-bold text-foreground">
                {c.title}
            </h1>
            <p class="text-muted-foreground text-lg">
                {c.subtitle}
            </p>
            <a
                href={`/${lang}`}
                class="bg-k-green hover:bg-k-green-dark text-primary-foreground px-8 py-3 rounded-2xl font-bold text-sm tracking-wide transition-all active:scale-[0.97] border-2 border-k-green-light"
            >
                {c.cta}
            </a>
        </div>
    </main>
</MainLayout>
