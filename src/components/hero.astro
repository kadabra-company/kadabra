---
import { getLangFromUrl, getTranslations } from "../lib/i18n";

const { url } = Astro;
const lang = getLangFromUrl(url);
const t = getTranslations(lang);
---

<section class="relative overflow-hidden">
    <!-- Gradiente decorativo de fondo -->
    <div class="absolute inset-0 -z-10">
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-200 h-125 bg-k-green/15 rounded-full blur-3xl"
        >
        </div>
    </div>

    <div
        class="max-w-7xl mx-auto px-6 pt-32 pb-24 flex flex-col items-center text-center gap-6"
    >
        <!-- Badge -->
        <span
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-border bg-muted text-foreground text-sm font-medium"
        >
            <span class="w-1.5 h-1.5 rounded-full bg-k-green animate-pulse"
            ></span>
            {t.hero.badge}
        </span>

        <!-- Título -->
        <h1
            class="text-5xl md:text-7xl font-bold tracking-tight text-foreground max-w-4xl leading-tight"
        >
            {t.hero.title}
        </h1>

        <!-- Subtítulo -->
        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl">
            {t.hero.subtitle}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center gap-4 mt-4">
            <a
                href={`/${lang}/contacto`}
                class="bg-k-green hover:bg-k-green-dark text-primary-foreground px-8 py-4 rounded-2xl font-bold text-sm tracking-wide transition-all active:scale-[0.97] border-2 border-k-green-light"
            >
                {t.hero.cta_primary}
            </a>
            <a
                href={`/${lang}/servicios`}
                class="bg-k-dark hover:bg-k-dark-dark text-primary-foreground px-8 py-4 rounded-2xl font-bold text-sm tracking-wide transition-all active:scale-[0.97] border-2 border-k-dark-light"
            >
                {t.hero.cta_secondary} →
            </a>
        </div>
    </div>
</section>
