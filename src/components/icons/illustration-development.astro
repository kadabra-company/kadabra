<!-- Ilustración: ventana de código con líneas y brackets -->
<svg
    viewBox="0 0 320 240"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full"
>
    <!-- Ventana -->
    <rect
        x="20"
        y="20"
        width="280"
        height="200"
        rx="16"
        fill="currentColor"
        fill-opacity="0.06"
        stroke="currentColor"
        stroke-opacity="0.15"
        stroke-width="1.5"></rect>
    <!-- Barra superior -->
    <rect
        x="20"
        y="20"
        width="280"
        height="36"
        rx="16"
        fill="currentColor"
        fill-opacity="0.1"></rect>
    <rect
        x="20"
        y="42"
        width="280"
        height="14"
        fill="currentColor"
        fill-opacity="0.1"></rect>
    <!-- Dots -->
    <circle cx="44" cy="38" r="5" fill="currentColor" fill-opacity="0.5"
    ></circle>
    <circle cx="62" cy="38" r="5" fill="currentColor" fill-opacity="0.3"
    ></circle>
    <circle cx="80" cy="38" r="5" fill="currentColor" fill-opacity="0.2"
    ></circle>
    <!-- Líneas de código -->
    <!-- Línea 1: bracket + keyword -->
    <text
        x="40"
        y="88"
        font-family="monospace"
        font-size="13"
        fill="currentColor"
        fill-opacity="0.9"
        font-weight="bold">&lt;</text
    >
    <rect
        x="52"
        y="78"
        width="52"
        height="12"
        rx="3"
        fill="currentColor"
        fill-opacity="0.4"></rect>
    <text
        x="112"
        y="88"
        font-family="monospace"
        font-size="13"
        fill="currentColor"
        fill-opacity="0.9"
        font-weight="bold">&gt;</text
    >
    <!-- Línea 2 indentada -->
    <rect
        x="56"
        y="98"
        width="36"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.25"></rect>
    <rect
        x="100"
        y="98"
        width="64"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.15"></rect>
    <!-- Línea 3 indentada -->
    <rect
        x="56"
        y="116"
        width="24"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.25"></rect>
    <rect
        x="88"
        y="116"
        width="80"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.35"></rect>
    <!-- Línea 4 -->
    <rect
        x="56"
        y="134"
        width="48"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.15"></rect>
    <rect
        x="112"
        y="134"
        width="40"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.25"></rect>
    <!-- Línea 5: cierre -->
    <text
        x="40"
        y="162"
        font-family="monospace"
        font-size="13"
        fill="currentColor"
        fill-opacity="0.9"
        font-weight="bold">&lt;/</text
    >
    <rect
        x="60"
        y="152"
        width="48"
        height="12"
        rx="3"
        fill="currentColor"
        fill-opacity="0.3"></rect>
    <text
        x="116"
        y="162"
        font-family="monospace"
        font-size="13"
        fill="currentColor"
        fill-opacity="0.9"
        font-weight="bold">&gt;</text
    >
    <!-- Cursor parpadeante -->
    <rect
        x="132"
        y="116"
        width="3"
        height="12"
        rx="1"
        fill="currentColor"
        fill-opacity="0.8"></rect>
    <!-- Línea decorativa derecha -->
    <rect
        x="220"
        y="78"
        width="60"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.1"></rect>
    <rect
        x="220"
        y="96"
        width="44"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.08"></rect>
    <rect
        x="220"
        y="114"
        width="52"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.1"></rect>
    <rect
        x="220"
        y="132"
        width="36"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.08"></rect>
    <rect
        x="220"
        y="150"
        width="48"
        height="10"
        rx="3"
        fill="currentColor"
        fill-opacity="0.1"></rect>
    <!-- Línea numeración -->
    <rect
        x="24"
        y="70"
        width="1.5"
        height="140"
        fill="currentColor"
        fill-opacity="0.1"></rect>
</svg>
