<!-- Ilustración: nodos conectados representando integraciones -->
<svg
    viewBox="0 0 320 240"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full"
>
    <!-- Líneas de conexión -->
    <line
        x1="100"
        y1="120"
        x2="160"
        y2="80"
        stroke="currentColor"
        stroke-opacity="0.2"
        stroke-width="1.5"
        stroke-dasharray="5 4"></line>
    <line
        x1="100"
        y1="120"
        x2="160"
        y2="160"
        stroke="currentColor"
        stroke-opacity="0.2"
        stroke-width="1.5"
        stroke-dasharray="5 4"></line>
    <line
        x1="220"
        y1="80"
        x2="160"
        y2="80"
        stroke="currentColor"
        stroke-opacity="0.2"
        stroke-width="1.5"
        stroke-dasharray="5 4"></line>
    <line
        x1="220"
        y1="160"
        x2="160"
        y2="160"
        stroke="currentColor"
        stroke-opacity="0.2"
        stroke-width="1.5"
        stroke-dasharray="5 4"></line>
    <line
        x1="100"
        y1="120"
        x2="60"
        y2="80"
        stroke="currentColor"
        stroke-opacity="0.15"
        stroke-width="1.5"
        stroke-dasharray="5 4"></line>
    <line
        x1="100"
        y1="120"
        x2="60"
        y2="160"
        stroke="currentColor"
        stroke-opacity="0.15"
        stroke-width="1.5"
        stroke-dasharray="5 4"></line>

    <!-- Nodo central -->
    <circle
        cx="160"
        cy="120"
        r="28"
        fill="currentColor"
        fill-opacity="0.12"
        stroke="currentColor"
        stroke-opacity="0.4"
        stroke-width="2"></circle>
    <circle cx="160" cy="120" r="18" fill="currentColor" fill-opacity="0.18"
    ></circle>
    <!-- K isotype simplificado en centro -->
    <text
        x="153"
        y="125"
        font-family="monospace"
        font-size="14"
        fill="currentColor"
        fill-opacity="0.8"
        font-weight="bold">K</text
    >

    <!-- Nodo superior derecho: SAP -->
    <rect
        x="204"
        y="58"
        width="44"
        height="44"
        rx="12"
        fill="currentColor"
        fill-opacity="0.1"
        stroke="currentColor"
        stroke-opacity="0.3"
        stroke-width="1.5"></rect>
    <text
        x="213"
        y="85"
        font-family="monospace"
        font-size="11"
        fill="currentColor"
        fill-opacity="0.7"
        font-weight="bold">SAP</text
    >

    <!-- Nodo inferior derecho: API -->
    <rect
        x="204"
        y="138"
        width="44"
        height="44"
        rx="12"
        fill="currentColor"
        fill-opacity="0.1"
        stroke="currentColor"
        stroke-opacity="0.3"
        stroke-width="1.5"></rect>
    <text
        x="213"
        y="165"
        font-family="monospace"
        font-size="11"
        fill="currentColor"
        fill-opacity="0.7"
        font-weight="bold">API</text
    >

    <!-- Nodo izquierdo: DB -->
    <rect
        x="64"
        y="98"
        width="44"
        height="44"
        rx="12"
        fill="currentColor"
        fill-opacity="0.08"
        stroke="currentColor"
        stroke-opacity="0.2"
        stroke-width="1.5"></rect>
    <text
        x="76"
        y="125"
        font-family="monospace"
        font-size="11"
        fill="currentColor"
        fill-opacity="0.5"
        font-weight="bold">DB</text
    >

    <!-- Nodo superior izquierdo pequeño -->
    <circle
        cx="60"
        cy="80"
        r="14"
        fill="currentColor"
        fill-opacity="0.07"
        stroke="currentColor"
        stroke-opacity="0.15"
        stroke-width="1.5"></circle>
    <!-- Nodo inferior izquierdo pequeño -->
    <circle
        cx="60"
        cy="160"
        r="14"
        fill="currentColor"
        fill-opacity="0.07"
        stroke="currentColor"
        stroke-opacity="0.15"
        stroke-width="1.5"></circle>

    <!-- Puntos de conexión animados -->
    <circle cx="130" cy="100" r="3" fill="currentColor" fill-opacity="0.5"
    ></circle>
    <circle cx="190" cy="100" r="3" fill="currentColor" fill-opacity="0.5"
    ></circle>
    <circle cx="130" cy="140" r="3" fill="currentColor" fill-opacity="0.5"
    ></circle>
    <circle cx="190" cy="140" r="3" fill="currentColor" fill-opacity="0.5"
    ></circle>
</svg>
