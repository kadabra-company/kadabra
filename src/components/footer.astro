---
import { getLangFromUrl, getTranslations } from "../lib/i18n";
import { Mail, Headset } from "@lucide/astro";
import WhatsappIcon from "./icons/whatsapp-icon.astro";
import GithubIcon from "./icons/github-icon.astro";
import LinkedinIcon from "./icons/linkedin-icon.astro";

const { url } = Astro;
const lang = getLangFromUrl(url);
const t = getTranslations(lang);

const year = new Date().getFullYear();
const whatsapp = t.footer.social.whatsapp.replace(/[^0-9]/g, "");
---

<footer class="border-t border-border bg-card mt-auto">
    <div class="max-w-7xl mx-auto px-6 py-6">
        <div
            class="flex flex-col md:flex-row items-center md:items-center justify-between gap-6"
        >
            <!-- Logo + tagline -->
            <div class="flex flex-col items-center md:items-start gap-2">
                <a href={`/${lang}`} class="flex items-center gap-1 group">
                    <img
                        src="/logo/main-logo.png"
                        alt="Kadabra"
                        class="h-8 w-auto transition-transform group-hover:scale-105"
                    />
                    <span
                        class="text-xl font-bold tracking-wide text-foreground"
                    >
                        adabra
                    </span>
                </a>
                <p
                    class="text-sm text-muted-foreground max-w-xs text-center md:text-left"
                >
                    {t.footer.tagline}
                </p>
            </div>

            <!-- Link Contacto (centro) -->
            <a
                href={`/${lang}/contacto`}
                class="flex items-center gap-2 text-sm font-bold text-k-green dark:text-k-green-light hover:text-k-green-light transition-colors"
            >
                <Headset class="h-4 w-4" />
                {t.footer.contact_link}
            </a>

            <!-- Redes sociales -->
            <div class="flex flex-col items-center md:items-end gap-4">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-muted-foreground"
                >
                    {t.footer.social_label}
                </p>
                <div class="flex items-center gap-3">
                    <!-- LinkedIn -->
                    <a
                        href={t.footer.social.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <LinkedinIcon class="h-5 w-5" />
                    </a>

                    <!-- GitHub -->
                    <a
                        href={t.footer.social.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="GitHub"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <GithubIcon class="h-5 w-5" />
                    </a>

                    <!-- Email -->
                    <a
                        href={`mailto:${t.footer.social.email}`}
                        aria-label="Email"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <Mail class="h-5 w-5" />
                    </a>

                    <!-- WhatsApp -->
                    <a
                        href={`https://wa.me/${whatsapp}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="WhatsApp"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <WhatsappIcon class="h-5 w-5" />
                    </a>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div
            class="mt-4 pt-4 border-t border-border text-center text-xs text-muted-foreground"
        >
            © {year} Kadabra. {t.footer.copyright}
        </div>
    </div>

    <!-- Botón flotante WhatsApp -->
    <a
        href={`https://wa.me/${whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.contact_page.whatsapp_label}
        class="whatsapp-fab"
    >
        <WhatsappIcon class="h-6 w-6" />
        <span class="whatsapp-fab-tooltip">{t.contact_page.whatsapp_label}</span>
        <span class="whatsapp-fab-badge" aria-hidden="true">1</span>
    </a>
</footer>
