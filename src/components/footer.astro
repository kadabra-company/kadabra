---
import { getLangFromUrl, getTranslations } from "../lib/i18n";
import { Linkedin, Github, Mail, Headset } from "lucide-astro";

const { url } = Astro;
const lang = getLangFromUrl(url);
const t = getTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-card mt-auto">
    <div class="max-w-7xl mx-auto px-6 py-6">
        <div
            class="flex flex-col md:flex-row items-center md:items-center justify-between gap-6"
        >
            <!-- Logo + tagline -->
            <div class="flex flex-col items-center md:items-start gap-2">
                <a href={`/${lang}`} class="flex items-center gap-1 group">
                    <img
                        src="/logo/main-logo.png"
                        alt="Kadabra"
                        class="h-8 w-auto transition-transform group-hover:scale-105"
                    />
                    <span
                        class="text-xl font-bold tracking-wide text-foreground"
                    >
                        adabra
                    </span>
                </a>
                <p
                    class="text-sm text-muted-foreground max-w-xs text-center md:text-left"
                >
                    {t.footer.tagline}
                </p>
            </div>

            <!-- Link Contacto (centro) -->
            <a
                href={`/${lang}/contacto`}
                class="flex items-center gap-2 text-sm font-bold text-k-green hover:text-k-green-light transition-colors"
            >
                <Headset class="h-4 w-4" />
                {t.footer.contact_link}
            </a>

            <!-- Redes sociales -->
            <div class="flex flex-col items-center md:items-end gap-4">
                <p
                    class="text-xs font-bold tracking-widest uppercase text-muted-foreground"
                >
                    {t.footer.social_label}
                </p>
                <div class="flex items-center gap-3">
                    <!-- LinkedIn -->
                    <a
                        href={t.footer.social.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <Linkedin class="h-5 w-5" />
                    </a>

                    <!-- GitHub -->
                    <a
                        href={t.footer.social.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="GitHub"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <Github class="h-5 w-5" />
                    </a>

                    <!-- Email -->
                    <a
                        href={`mailto:${t.footer.social.email}`}
                        aria-label="Email"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <Mail class="h-5 w-5" />
                    </a>

                    <!-- WhatsApp -->
                    <a
                        href={`https://wa.me/${t.footer.social.whatsapp.replace(/[^0-9]/g, "")}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="WhatsApp"
                        class="p-2 rounded-xl text-muted-foreground hover:text-foreground hover:bg-muted transition-all"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div
            class="mt-4 pt-4 border-t border-border text-center text-xs text-muted-foreground"
        >
            © {year} Kadabra. {t.footer.copyright}
        </div>
    </div>
</footer>
